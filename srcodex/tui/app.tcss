/* Main screen layout - 3 columns */
Screen {
    layout: horizontal;
}

/* Left panel - File Browser */
#left {
    width: 0.8fr;
    height: 100%;
    border: grey;
    overflow-y: auto;
}

/* Middle panel - Code Viewer */
#middle {
    width: 2fr;
    border: grey;
}

/* Right panel - AI Chat */
#right {
    width: 1.4fr;
    border: grey;
}