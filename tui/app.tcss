/* Main screen layout - 3 columns */
Screen {
    layout: horizontal;
}

/* Left panel - File Browser */
#left {
    width: 20%;
    height: 100%;
    border: solid green;
    overflow-y: auto;
}

/* Middle panel - Code Viewer */
#middle {
    width: 50%;
    border: solid blue;
}

/* Right panel - AI Chat */
#right {
    width: 30%;
    border: solid yellow;
}